RANDOM_SEED: int = 42
np.random.seed(RANDOM_SEED)

EXPECTED_SHEETS_HINT = "e.g. '24HY1', '24H2'"
DATE_COLUMN_NAME: str = "Mat.avail.dt"
POUNDS_COLUMN_NAME: str = "Net Pounds"
CUSTOMER_COLUMN_ALIASES: List[str] = [
    "customer", "cg3", "customer group 3", "customergroup3", "cust group 3",
    "customer group", "sold to party", "soldtoparty", "sold to", "customer name",
]
MATERIAL_GROUP_COLUMN_ALIASES: List[str] = [
    "material group", "materialgroup", "matl group", "mat group", "material grp",
    "matgroup", "product group", "productgroup", "material category",
]

DEFAULT_HORIZON_DAYS: int = 21
SEASONAL_PERIOD: int = 7
ANNUAL_PERIOD: float = 365.25
N_BACKTEST_WINDOWS_PREFERRED: int = 8
MIN_TRAIN_DAYS: int = 60
MIN_FIT_DAYS: int = 21  # absolute floor to even attempt a final fit/forecast

OVERALL_CUSTOMER_KEY: str = "__OVERALL__"
OVERALL_MATERIAL_KEY: str = "__OVERALL__"

MODEL_NAMES: List[str] = ["Seasonal Naive", "AutoARIMA", "AutoETS", "HistGradientBoostingRegressor"]
LAG_DAYS: List[int] = [1, 2, 3, 7, 14, 21, 28]
ROLLING_WINDOWS: List[int] = [7, 14, 28]
HGB_FEATURE_COLUMNS: List[str] = (
    [f"lag_{l}" for l in LAG_DAYS]
    + [f"roll_mean_{w}" for w in ROLLING_WINDOWS]
    + ["roll_std_7", "day_of_week", "is_weekend", "month", "quarter",
       "day_of_year", "weekly_sin", "weekly_cos", "annual_sin", "annual_cos"]
)


# =============================================================================
# COLUMN / SHEET NAME NORMALIZATION (same logic as production_forecasting_mvp.py)
# =============================================================================

def _normalize_token(name: object) -> str:
    return re.sub(r"[^a-z0-9]", "", str(name).strip().lower())


_NORM_DATE_COL = _normalize_token(DATE_COLUMN_NAME)
_NORM_POUNDS_COL = _normalize_token(POUNDS_COLUMN_NAME)
_NORM_CUSTOMER_ALIASES = {_normalize_token(a) for a in CUSTOMER_COLUMN_ALIASES}
_NORM_MATERIAL_GROUP_ALIASES = {_normalize_token(a) for a in MATERIAL_GROUP_COLUMN_ALIASES}
_HALF_YEAR_SHEET_RE = re.compile(r"^(\d{2})h(?:y)?([12])$")


def is_half_year_sheet(sheet_name: str) -> bool:
    return _HALF_YEAR_SHEET_RE.match(_normalize_token(sheet_name)) is not None


def half_year_sort_key(sheet_name: str) -> Tuple[int, int]:
    m = _HALF_YEAR_SHEET_RE.match(_normalize_token(sheet_name))
    return (int(m.group(1)), int(m.group(2))) if m else (99, 9)


def find_target_columns(columns: List[object]) -> Tuple[Optional[object], Optional[object]]:
    date_col, pounds_col = None, None
    for c in columns:
        norm = _normalize_token(c)
        if norm == _NORM_DATE_COL and date_col is None:
            date_col = c
        elif norm == _NORM_POUNDS_COL and pounds_col is None:
            pounds_col = c
    return date_col, pounds_col


def find_segment_columns(columns: List[object]) -> Tuple[Optional[object], Optional[object]]:
    customer_col, material_col = None, None
    for c in columns:
        norm = _normalize_token(c)
        if norm in _NORM_CUSTOMER_ALIASES and customer_col is None:
            customer_col = c
        elif norm in _NORM_MATERIAL_GROUP_ALIASES and material_col is None:
            material_col = c
    return customer_col, material_col


_NUMERIC_STRIP_RE = re.compile(r"[^0-9.\-]")


def clean_net_pounds_value(raw: object) -> Optional[float]:
    """Same rules as the interactive app: commas are thousands separators,
    parentheses mean negative, anything unparseable returns None (never 0)."""
    if raw is None or (isinstance(raw, float) and np.isnan(raw)):
        return None
    if isinstance(raw, (int, float, np.integer, np.floating)):
        val = float(raw)
        return None if np.isnan(val) else val
    s = str(raw).strip()
    if s == "" or s.lower() in {"nan", "none", "n/a", "na", "-"}:
        return None
    negative = False
    if s.startswith("(") and s.endswith(")"):
        negative = True
        s = s[1:-1].strip()
    s_clean = _NUMERIC_STRIP_RE.sub("", s.replace(",", "").replace(" ", ""))
    if s_clean in {"", "-", "."} or s_clean.count(".") > 1 or s_clean.count("-") > 1:
        return None
    try:
        val = float(s_clean)
    except ValueError:
        return None
    return -val if negative else val


def load_and_clean_workbook(path: Union[str, Path]) -> pd.DataFrame:
    """Read every half-year sheet, clean it, and return one combined
    dataframe with standardized columns: date, net_pounds, customer
    (if present), material_group (if present). Exact mirror of the
    interactive app's cleaning rules, minus the data-quality reporting
    (this script logs summary counts instead of building a UI report)."""
    raw_sheets = pd.read_excel(path, sheet_name=None, engine="openpyxl")
    matched = {name: df for name, df in raw_sheets.items() if is_half_year_sheet(name)}
    matched = dict(sorted(matched.items(), key=lambda kv: half_year_sort_key(kv[0])))
    if not matched:
        raise ValueError(
            f"No sheets matching the half-year naming convention ({EXPECTED_SHEETS_HINT}) found. "
            f"Sheets present: {list(raw_sheets.keys())}"
        )
    log.info("Matched %d half-year sheet(s): %s", len(matched), list(matched.keys()))

    cleaned_frames = []
    total_loaded = total_invalid_date = total_invalid_pounds = 0
    for sheet_name, df in matched.items():
        date_col, pounds_col = find_target_columns(list(df.columns))
        if date_col is None or pounds_col is None:
            log.warning("Sheet '%s': could not find date/Net Pounds columns -- skipped.", sheet_name)
            continue
        working = df.copy()
        working["__date__"] = pd.to_datetime(working[date_col], errors="coerce")
        working["__net_pounds__"] = working[pounds_col].apply(clean_net_pounds_value)
        invalid_date = working["__date__"].isna()
        invalid_pounds = working["__net_pounds__"].isna()
        total_loaded += len(working)
        total_invalid_date += int(invalid_date.sum())
        total_invalid_pounds += int(invalid_pounds.sum())

        clean = working.loc[~(invalid_date | invalid_pounds)].copy()
        clean["sheet"] = sheet_name
        clean["date"] = clean["__date__"].dt.normalize()
        clean["net_pounds"] = clean["__net_pounds__"]
        clean = clean.drop(columns=["__date__", "__net_pounds__"])

        customer_col, material_col = find_segment_columns(list(df.columns))
        if customer_col is not None:
            clean["customer"] = clean[customer_col].astype(str).str.strip()
        if material_col is not None:
            clean["material_group"] = clean[material_col].astype(str).str.strip()

        cleaned_frames.append(clean)

    combined = pd.concat(cleaned_frames, ignore_index=True, sort=False) if cleaned_frames else pd.DataFrame()
    if combined.empty:
        raise ValueError("No valid rows survived cleaning across all sheets.")

    dedup_cols = [c for c in combined.columns if c != "sheet"]
    dup_count = int(combined.duplicated(subset=dedup_cols, keep="first").sum())
    combined = combined.loc[~combined.duplicated(subset=dedup_cols, keep="first")].copy()

    log.info(
        "Cleaning summary: %d rows loaded, %d invalid dates, %d invalid Net Pounds, "
        "%d duplicates removed, %d valid rows remain.",
        total_loaded, total_invalid_date, total_invalid_pounds, dup_count, len(combined),
    )
    if "customer" not in combined.columns or "material_group" not in combined.columns:
        raise ValueError(
            "No customer / material group columns were recognized in this workbook. "
            "Add your exact header text to CUSTOMER_COLUMN_ALIASES / "
            "MATERIAL_GROUP_COLUMN_ALIASES near the top of this file."
        )
    return combined


# =============================================================================
# SEGMENT ENUMERATION + AGGREGATION
# =============================================================================

@dataclass
class Segment:
    customer: str
    material_group: str
    is_overall: bool = False


def enumerate_segments(combined: pd.DataFrame, limit: Optional[int] = None) -> List[Segment]:
    """Every (customer, material_group) combination that actually has data,
    plus the overall (all-customer, all-material) segment first."""
    segments = [Segment(OVERALL_CUSTOMER_KEY, OVERALL_MATERIAL_KEY, is_overall=True)]
    pairs = (
        combined[["customer", "material_group"]]
        .dropna().drop_duplicates()
        .sort_values(["customer", "material_group"])
    )
    for _, row in pairs.iterrows():
        segments.append(Segment(row["customer"], row["material_group"]))
    if limit is not None:
        segments = segments[: limit + 1]  # +1 so --limit N always still includes the overall segment
    return segments


def aggregate_segment_series(combined: pd.DataFrame, segment: Segment) -> pd.Series:
    if segment.is_overall:
        subset = combined
    else:
        subset = combined.loc[
            (combined["customer"] == segment.customer) & (combined["material_group"] == segment.material_group)
        ]
    if subset.empty:
        return pd.Series(dtype=float)
    s = subset.groupby("date")["net_pounds"].sum().sort_index()
    s.index = pd.DatetimeIndex(s.index)
    full_index = pd.date_range(s.index.min(), s.index.max(), freq="D")
    return s.reindex(full_index)  # dense, true gaps as NaN


def historical_slice(dense_series: pd.Series, as_of_date: pd.Timestamp) -> pd.Series:
    return dense_series.loc[dense_series.index <= as_of_date]


def backlog_slice(dense_series: pd.Series, as_of_date: pd.Timestamp) -> pd.Series:
    return dense_series.loc[dense_series.index > as_of_date]


def modeling_series_for(historical: pd.Series) -> pd.Series:
    """Same default as the interactive app's 'interpolate for modeling only'
    option -- gaps are filled for model fitting, but callers keep the dense
    (true-gap) series separately for anything that needs the raw truth."""
    return historical.interpolate(method="linear", limit_direction="both")


def achievable_n_windows(n_obs: int, horizon: int, min_train: int = MIN_TRAIN_DAYS,
                          preferred: int = N_BACKTEST_WINDOWS_PREFERRED) -> int:
    """How many non-overlapping backtest windows this segment's history can
    support, 0 if there isn't even enough for one."""
    if n_obs < min_train + horizon:
        return 0
    return max(1, min(preferred, (n_obs - min_train) // horizon))


# =============================================================================
# METRICS
# =============================================================================

def compute_wape(y_true: np.ndarray, y_pred: np.ndarray) -> float:
    denom = np.sum(np.abs(y_true))
    return np.nan if denom == 0 else 100.0 * np.sum(np.abs(y_true - y_pred)) / denom


def compute_mae(y_true, y_pred) -> float:
    return float(np.mean(np.abs(y_true - y_pred)))


def compute_rmse(y_true, y_pred) -> float:
    return float(np.sqrt(np.mean((y_true - y_pred) ** 2)))


def compute_smape(y_true, y_pred) -> float:
    denom = np.abs(y_true) + np.abs(y_pred)
    with np.errstate(divide="ignore", invalid="ignore"):
        ratio = np.where(denom == 0, 0.0, 2.0 * np.abs(y_true - y_pred) / denom)
    return 100.0 * float(np.mean(ratio))


def compute_mase(y_true, y_pred, in_sample_history: np.ndarray, seasonal_period: int = SEASONAL_PERIOD) -> float:
    if len(in_sample_history) <= seasonal_period:
        return np.nan
    naive_errors = np.abs(in_sample_history[seasonal_period:] - in_sample_history[:-seasonal_period])
    scale = np.mean(naive_errors)
    return np.nan if scale == 0 else float(np.mean(np.abs(y_true - y_pred)) / scale)


def compute_bias(y_true, y_pred) -> float:
    return float(np.mean(y_pred - y_true))


def compute_abs_pct_bias(y_true, y_pred) -> float:
    total_true = np.sum(y_true)
    return np.nan if total_true == 0 else 100.0 * abs(np.sum(y_pred) - total_true) / abs(total_true)


def wape_based_accuracy(wape: float) -> float:
    return np.nan if np.isnan(wape) else max(0.0, 100.0 - wape)


@dataclass
class ModelMetrics:
    model_name: str
    wape: float = np.nan
    mae: float = np.nan
    rmse: float = np.nan
    smape: float = np.nan
    mase: float = np.nan
    bias: float = np.nan
    abs_pct_bias: float = np.nan
    accuracy_score: float = np.nan
    n_success_windows: int = 0
    n_failed_windows: int = 0
    skipped: bool = False
    skip_reason: str = ""


def metrics_from_windows(model_name: str, y_true_list: List[np.ndarray], y_pred_list: List[np.ndarray],
                          n_failed: int, full_history: np.ndarray) -> ModelMetrics:
    if not y_true_list:
        return ModelMetrics(model_name, n_failed_windows=n_failed, skipped=True,
                             skip_reason="No successful backtest windows (insufficient history).")
    y_true = np.concatenate(y_true_list)
    y_pred = np.concatenate(y_pred_list)
    wape = compute_wape(y_true, y_pred)
    n_success = len(y_true_list)
    failure_rate = n_failed / (n_failed + n_success) if (n_failed + n_success) else 0.0
    m = ModelMetrics(
        model_name=model_name, wape=wape, mae=compute_mae(y_true, y_pred), rmse=compute_rmse(y_true, y_pred),
        smape=compute_smape(y_true, y_pred), mase=compute_mase(y_true, y_pred, full_history),
        bias=compute_bias(y_true, y_pred), abs_pct_bias=compute_abs_pct_bias(y_true, y_pred),
        accuracy_score=wape_based_accuracy(wape), n_success_windows=n_success, n_failed_windows=n_failed,
    )
    if failure_rate > 0.20:
        m.skipped = True
        m.skip_reason = f"{n_failed} of {n_failed + n_success} backtest windows failed (>20%)."
    return m


# =============================================================================
# HistGradientBoostingRegressor (per-segment: sklearn has no native panel/
# multi-series fitting the way statsforecast does, so this one still loops,
# but each fit is cheap -- well under a second per segment in practice).
# =============================================================================

def build_hgb_features(series: pd.Series) -> pd.DataFrame:
    df = pd.DataFrame({"y": series.astype(float)})
    df.index = pd.DatetimeIndex(df.index)
    shifted = df["y"].shift(1)
    for lag in LAG_DAYS:
        df[f"lag_{lag}"] = df["y"].shift(lag)
    for window in ROLLING_WINDOWS:
        df[f"roll_mean_{window}"] = shifted.rolling(window, min_periods=max(2, window // 2)).mean()
    df["roll_std_7"] = shifted.rolling(7, min_periods=3).std()
    dow, doy = df.index.dayofweek, df.index.dayofyear
    df["day_of_week"] = dow
    df["is_weekend"] = (dow >= 5).astype(int)
    df["month"] = df.index.month
    df["quarter"] = df.index.quarter
    df["day_of_year"] = doy
    df["weekly_sin"] = np.sin(2 * np.pi * dow / SEASONAL_PERIOD)
    df["weekly_cos"] = np.cos(2 * np.pi * dow / SEASONAL_PERIOD)
    df["annual_sin"] = np.sin(2 * np.pi * doy / ANNUAL_PERIOD)
    df["annual_cos"] = np.cos(2 * np.pi * doy / ANNUAL_PERIOD)
    return df


def fit_hgb(train: pd.Series):
    from sklearn.ensemble import HistGradientBoostingRegressor
    features = build_hgb_features(train.dropna())
    rows = features.dropna(subset=HGB_FEATURE_COLUMNS)
    if len(rows) < 30:
        return None
    model = HistGradientBoostingRegressor(random_state=RANDOM_SEED, min_samples_leaf=5)
    model.fit(rows[HGB_FEATURE_COLUMNS].to_numpy(), rows["y"].to_numpy())
    return model


def predict_hgb(model, history: pd.Series, horizon: int, future_dates: List[pd.Timestamp]) -> np.ndarray:
    if model is None:
        return np.full(horizon, np.nan)
    working = history.copy()
    preds = []
    for target_date in future_dates:
        working = working.reindex(pd.date_range(working.index.min(), target_date, freq="D"))
        feats = build_hgb_features(working)
        row = feats.loc[[target_date], HGB_FEATURE_COLUMNS].fillna(0.0)
        pred = max(0.0, float(model.predict(row.to_numpy())[0]))
        preds.append(pred)
        working.loc[target_date] = pred
    return np.array(preds)


def backtest_hgb(modeling_series: pd.Series, horizon: int) -> ModelMetrics:
    n_windows = achievable_n_windows(len(modeling_series), horizon)
    if n_windows == 0:
        return ModelMetrics("HistGradientBoostingRegressor", skipped=True,
                             skip_reason="Not enough history for the chosen horizon.")
    y_true_list, y_pred_list, n_failed = [], [], 0
    for k in range(n_windows, 0, -1):
        train_len = len(modeling_series) - horizon * k
        train = modeling_series.iloc[:train_len]
        test = modeling_series.iloc[train_len: train_len + horizon]
        if len(test) < horizon:
            continue
        try:
            model = fit_hgb(train)
            preds = predict_hgb(model, train, horizon, list(test.index))
            if model is None or np.any(np.isnan(preds)):
                n_failed += 1
            else:
                y_true_list.append(test.to_numpy())
                y_pred_list.append(preds)
        except Exception:
            n_failed += 1
    return metrics_from_windows("HistGradientBoostingRegressor", y_true_list, y_pred_list, n_failed,
                                 modeling_series.values)


# =============================================================================
# VECTORIZED STATSFORECAST BACKTEST + FINAL FORECAST (Seasonal Naive, AutoARIMA, AutoETS)
#
# These 3 models ARE natively vectorized by statsforecast across many
# series in one call -- the key to making 800+ segments tractable. Segments
# are bucketed by how many backtest windows their history can support (a
# single cross_validation() call requires the same n_windows for every
# series in it), so this is a handful of batched calls instead of hundreds
# of individual ones.
# =============================================================================

_STATSFORECAST_MODEL_NAMES = {"SeasonalNaive": "Seasonal Naive", "AutoARIMA": "AutoARIMA", "AutoETS": "AutoETS"}


def _build_statsforecast_models(fast_arima: bool):
    from statsforecast.models import AutoARIMA, AutoETS, SeasonalNaive
    arima_kwargs = dict(season_length=SEASONAL_PERIOD)
    if fast_arima:
        arima_kwargs.update(approximation=True, max_order=3, max_p=2, max_q=2, max_P=1, max_Q=1)
    return [
        SeasonalNaive(season_length=SEASONAL_PERIOD),
        AutoARIMA(**arima_kwargs),
        AutoETS(season_length=SEASONAL_PERIOD),
    ]


def vectorized_backtest(
    modeling_series_by_id: Dict[str, pd.Series], horizon: int, preferred_windows: int,
    fast_arima: bool, n_jobs: int,
) -> Dict[str, Dict[str, ModelMetrics]]:
    """Returns {unique_id: {model_name: ModelMetrics}} for Seasonal Naive,
    AutoARIMA, AutoETS across every segment, batched by achievable window
    count instead of looped one segment at a time."""
    from statsforecast import StatsForecast

    buckets: Dict[int, List[str]] = {}
    for uid, series in modeling_series_by_id.items():
        nw = achievable_n_windows(len(series.dropna()), horizon, preferred=preferred_windows)
        buckets.setdefault(nw, []).append(uid)

    results: Dict[str, Dict[str, ModelMetrics]] = {uid: {} for uid in modeling_series_by_id}

    for nw, uids in buckets.items():
        if nw == 0:
            for uid in uids:
                for name in _STATSFORECAST_MODEL_NAMES.values():
                    results[uid][name] = ModelMetrics(name, skipped=True,
                                                        skip_reason="Not enough history for the chosen horizon.")
            continue

        panel = pd.concat(
            [pd.DataFrame({"unique_id": uid, "ds": modeling_series_by_id[uid].dropna().index,
                            "y": modeling_series_by_id[uid].dropna().values}) for uid in uids],
            ignore_index=True,
        )
        sf = StatsForecast(models=_build_statsforecast_models(fast_arima), freq="D", n_jobs=n_jobs)
        try:
            cv = sf.cross_validation(df=panel, h=horizon, n_windows=nw, step_size=horizon)
        except Exception as exc:
            log.warning("Backtest bucket (n_windows=%d, %d segments) failed entirely: %s", nw, len(uids), exc)
            for uid in uids:
                for name in _STATSFORECAST_MODEL_NAMES.values():
                    results[uid][name] = ModelMetrics(name, skipped=True, skip_reason=f"Backtest error: {exc}")
            continue

        for uid in uids:
            sub = cv[cv["unique_id"] == uid]
            full_hist = modeling_series_by_id[uid].dropna().values
            for col, name in _STATSFORECAST_MODEL_NAMES.items():
                if col not in sub.columns or sub.empty:
                    results[uid][name] = ModelMetrics(name, skipped=True, skip_reason="No backtest output for this segment.")
                    continue
                # One array pair per distinct 'cutoff' (backtest origin), matching
                # the same per-window semantics metrics_from_windows expects --
                # NOT one big concatenated array, or n_success_windows would always
                # read as 1 regardless of how many windows actually ran.
                y_true_list, y_pred_list, n_failed = [], [], 0
                for _, window_df in sub.groupby("cutoff"):
                    y_true_w, y_pred_w = window_df["y"].to_numpy(), window_df[col].to_numpy()
                    valid = ~np.isnan(y_pred_w)
                    if valid.sum() == 0:
                        n_failed += 1
                    else:
                        y_true_list.append(y_true_w[valid])
                        y_pred_list.append(y_pred_w[valid])
                results[uid][name] = metrics_from_windows(name, y_true_list, y_pred_list, n_failed, full_hist)
    return results


def vectorized_final_forecast(
    modeling_series_by_id: Dict[str, pd.Series], horizon: int, fast_arima: bool, n_jobs: int,
) -> Dict[str, Dict[str, np.ndarray]]:
    """Fit-once-and-forecast (no backtest) for Seasonal Naive, AutoARIMA,
    AutoETS across every eligible segment in one vectorized call. Segments
    too short even for a single fit are simply left out (caller treats
    missing keys as skipped)."""
    from statsforecast import StatsForecast

    eligible = {uid: s for uid, s in modeling_series_by_id.items() if len(s.dropna()) >= MIN_FIT_DAYS}
    if not eligible:
        return {}
    panel = pd.concat(
        [pd.DataFrame({"unique_id": uid, "ds": s.dropna().index, "y": s.dropna().values})
         for uid, s in eligible.items()],
        ignore_index=True,
    )
    sf = StatsForecast(models=_build_statsforecast_models(fast_arima), freq="D", n_jobs=n_jobs)
    try:
        fc = sf.forecast(df=panel, h=horizon, level=[80])
    except Exception as exc:
        log.warning("Vectorized final forecast failed entirely: %s", exc)
        return {}

    out: Dict[str, Dict[str, np.ndarray]] = {}
    for uid in eligible:
        sub = fc[fc["unique_id"] == uid].sort_values("ds")
        if sub.empty:
            continue
        out[uid] = {}
        for col, name in _STATSFORECAST_MODEL_NAMES.items():
            if col in sub.columns:
                out[uid][name] = np.maximum(sub[col].to_numpy(), 0.0)
    return out


# =============================================================================
# SQLITE STORAGE (bulk results -- fast filtered reads, no re-running models)
# =============================================================================

_SCHEMA = """
CREATE TABLE IF NOT EXISTS segment_summary (
    run_date TEXT, customer TEXT, material_group TEXT,
    historical_days INTEGER, backlog_days INTEGER,
    best_model_by_wape TEXT, status TEXT, error_message TEXT,
    PRIMARY KEY (run_date, customer, material_group)
);
CREATE TABLE IF NOT EXISTS segment_metrics (
    run_date TEXT, customer TEXT, material_group TEXT, model TEXT,
    wape REAL, mae REAL, rmse REAL, smape REAL, mase REAL, bias REAL,
    abs_pct_bias REAL, accuracy_score REAL, n_success_windows INTEGER,
    n_failed_windows INTEGER, skipped INTEGER, skip_reason TEXT,
    PRIMARY KEY (run_date, customer, material_group, model)
);
CREATE TABLE IF NOT EXISTS segment_forecasts (
    run_date TEXT, customer TEXT, material_group TEXT, forecast_date TEXT,
    seasonal_naive REAL, autoarima REAL, autoets REAL, hgb REAL, average REAL,
    known_backlog REAL,
    PRIMARY KEY (run_date, customer, material_group, forecast_date)
);
CREATE INDEX IF NOT EXISTS idx_metrics_lookup ON segment_metrics (customer, material_group, run_date);
CREATE INDEX IF NOT EXISTS idx_forecast_lookup ON segment_forecasts (customer, material_group, run_date);
CREATE INDEX IF NOT EXISTS idx_summary_lookup ON segment_summary (customer, material_group, run_date);
"""


def get_connection(db_path: Union[str, Path]) -> sqlite3.Connection:
    conn = sqlite3.connect(str(db_path))
    conn.executescript(_SCHEMA)
    return conn


def segment_already_done(conn: sqlite3.Connection, run_date: str, customer: str, material_group: str) -> bool:
    cur = conn.execute(
        "SELECT 1 FROM segment_summary WHERE run_date=? AND customer=? AND material_group=? LIMIT 1",
        (run_date, customer, material_group),
    )
    return cur.fetchone() is not None


def write_segment_result(
    conn: sqlite3.Connection, run_date: str, customer: str, material_group: str,
    historical_days: int, backlog_days: int, metrics: List[ModelMetrics],
    forecast_df: Optional[pd.DataFrame], status: str = "ok", error_message: str = "",
) -> None:
    eligible = [m for m in metrics if not m.skipped]
    best_model = min(eligible, key=lambda m: m.wape).model_name if eligible else None

    conn.execute("DELETE FROM segment_summary WHERE run_date=? AND customer=? AND material_group=?",
                 (run_date, customer, material_group))
    conn.execute("DELETE FROM segment_metrics WHERE run_date=? AND customer=? AND material_group=?",
                 (run_date, customer, material_group))
    conn.execute("DELETE FROM segment_forecasts WHERE run_date=? AND customer=? AND material_group=?",
                 (run_date, customer, material_group))

    conn.execute(
        "INSERT INTO segment_summary VALUES (?,?,?,?,?,?,?,?)",
        (run_date, customer, material_group, historical_days, backlog_days, best_model, status, error_message),
    )
    for m in metrics:
        conn.execute(
            "INSERT INTO segment_metrics VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (run_date, customer, material_group, m.model_name, m.wape, m.mae, m.rmse, m.smape, m.mase,
             m.bias, m.abs_pct_bias, m.accuracy_score, m.n_success_windows, m.n_failed_windows,
             int(m.skipped), m.skip_reason),
        )
    if forecast_df is not None and not forecast_df.empty:
        rows = [
            (run_date, customer, material_group, str(r["forecast_date"]),
             r.get("Seasonal Naive"), r.get("AutoARIMA"), r.get("AutoETS"), r.get("HistGradientBoostingRegressor"),
             r.get("Average"), r.get("known_backlog"))
            for _, r in forecast_df.iterrows()
        ]
        conn.executemany("INSERT INTO segment_forecasts VALUES (?,?,?,?,?,?,?,?,?,?)", rows)
    conn.commit()


def read_segment_forecast(db_path: Union[str, Path], customer: str, material_group: str,
                           run_date: Optional[str] = None) -> pd.DataFrame:
    """Fast filtered read -- no model re-run. run_date=None returns the
    latest available run for this segment."""
    conn = get_connection(db_path)
    if run_date is None:
        row = conn.execute(
            "SELECT MAX(run_date) FROM segment_forecasts WHERE customer=? AND material_group=?",
            (customer, material_group),
        ).fetchone()
        run_date = row[0] if row else None
        if run_date is None:
            return pd.DataFrame()
    df = pd.read_sql(
        "SELECT * FROM segment_forecasts WHERE customer=? AND material_group=? AND run_date=? "
        "ORDER BY forecast_date",
        conn, params=(customer, material_group, run_date),
    )
    conn.close()
    return df


def read_segment_metrics(db_path: Union[str, Path], customer: str, material_group: str,
                          run_date: Optional[str] = None) -> pd.DataFrame:
    conn = get_connection(db_path)
    if run_date is None:
        row = conn.execute(
            "SELECT MAX(run_date) FROM segment_metrics WHERE customer=? AND material_group=?",
            (customer, material_group),
        ).fetchone()
        run_date = row[0] if row else None
        if run_date is None:
            return pd.DataFrame()
    df = pd.read_sql(
        "SELECT * FROM segment_metrics WHERE customer=? AND material_group=? AND run_date=? ORDER BY wape",
        conn, params=(customer, material_group, run_date),
    )
    conn.close()
    return df


def list_segments(db_path: Union[str, Path], run_date: Optional[str] = None) -> pd.DataFrame:
    """Quick overview of every segment's status for a run -- customer,
    material group, history length, best model, whether it succeeded."""
    conn = get_connection(db_path)
    if run_date is None:
        row = conn.execute("SELECT MAX(run_date) FROM segment_summary").fetchone()
        run_date = row[0] if row else None
        if run_date is None:
            return pd.DataFrame()
    df = pd.read_sql(
        "SELECT * FROM segment_summary WHERE run_date=? ORDER BY customer, material_group",
        conn, params=(run_date,),
    )
    conn.close()
    return df


