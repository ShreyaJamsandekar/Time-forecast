# MAIN ORCHESTRATION
# =============================================================================

def process_segment(
    segment: Segment, series: pd.Series, as_of: pd.Timestamp, horizon: int,
    vectorized_metrics: Dict[str, ModelMetrics], vectorized_forecast: Dict[str, np.ndarray],
) -> Tuple[List[ModelMetrics], Optional[pd.DataFrame], int, int]:
    """Combine the pre-computed vectorized (Seasonal Naive/AutoARIMA/AutoETS)
    results with a fresh per-segment HistGradientBoostingRegressor run, fold
    in the known-backlog floor, and build this segment's final wide
    forecast table + metrics list."""
    historical = historical_slice(series, as_of)
    backlog = backlog_slice(series, as_of)
    if historical.dropna().empty:
        return [], None, 0, 0
    modeling = modeling_series_for(historical)

    hgb_metrics = backtest_hgb(modeling, horizon)
    all_metrics = [vectorized_metrics.get(name, ModelMetrics(name, skipped=True, skip_reason="Not computed."))
                    for name in ["Seasonal Naive", "AutoARIMA", "AutoETS"]] + [hgb_metrics]

    last_hist_date = historical.dropna().index.max()
    future_dates = pd.date_range(last_hist_date + pd.Timedelta(days=1), periods=horizon, freq="D")

    hgb_model = fit_hgb(modeling)
    hgb_forecast = predict_hgb(hgb_model, modeling, horizon, list(future_dates))

    model_forecasts = dict(vectorized_forecast)
    model_forecasts["HistGradientBoostingRegressor"] = hgb_forecast

    rows = []
    for i, d in enumerate(future_dates):
        backlog_val = float(backlog.get(d, 0.0)) if not pd.isna(backlog.get(d, 0.0)) else 0.0
        row = {"forecast_date": d.date(), "known_backlog": backlog_val}
        vals = []
        for name in MODEL_NAMES:
            raw = model_forecasts.get(name)
            if raw is not None and not np.isnan(raw[i]):
                combined = max(float(raw[i]), backlog_val)  # backlog is a floor, same logic as the interactive app
                row[name] = combined
                vals.append(combined)
            else:
                row[name] = np.nan
        row["Average"] = float(np.mean(vals)) if vals else np.nan
        rows.append(row)

    return all_metrics, pd.DataFrame(rows), len(historical), int((~backlog.isna()).sum())


def run_batch(
    workbook_path: Union[str, Path], db_path: Union[str, Path], excel_out_path: Union[str, Path],
    horizon: int = DEFAULT_HORIZON_DAYS, preferred_windows: int = N_BACKTEST_WINDOWS_PREFERRED,
    fast_arima: bool = True, n_jobs: int = -1, limit: Optional[int] = None,
    overwrite: bool = False, as_of: Optional[pd.Timestamp] = None, run_date: Optional[str] = None,
) -> None:
    t_start = time.time()
    as_of = as_of or pd.Timestamp(date.today())
    run_date = run_date or str(date.today())

    log.info("Loading workbook: %s", workbook_path)
    combined = load_and_clean_workbook(workbook_path)

    segments = enumerate_segments(combined, limit=limit)
    log.info("Enumerated %d segment(s) (including the overall total).", len(segments))

    conn = get_connection(db_path)
    if not overwrite:
        segments = [s for s in segments if not segment_already_done(conn, run_date, s.customer, s.material_group)]
        log.info("%d segment(s) remaining after skipping ones already done for run_date=%s.", len(segments), run_date)
    if not segments:
        log.info("Nothing to do -- use --overwrite to recompute this run_date.")
        return

    log.info("Aggregating daily series for each segment...")
    series_by_key: Dict[str, pd.Series] = {}
    segment_by_key: Dict[str, Segment] = {}
    modeling_by_key: Dict[str, pd.Series] = {}
    for seg in segments:
        s = aggregate_segment_series(combined, seg)
        if s.dropna().empty:
            continue
        key = f"{seg.customer}||{seg.material_group}"
        series_by_key[key] = s
        segment_by_key[key] = seg
        hist = historical_slice(s, as_of)
        if not hist.dropna().empty:
            modeling_by_key[key] = modeling_series_for(hist)

    log.info("Running vectorized backtest (Seasonal Naive + AutoARIMA + AutoETS) across %d segments...",
              len(modeling_by_key))
    t0 = time.time()
    vec_metrics = vectorized_backtest(modeling_by_key, horizon, preferred_windows, fast_arima, n_jobs)
    log.info("Vectorized backtest done in %.1fs.", time.time() - t0)

    log.info("Running vectorized final forecast across %d segments...", len(modeling_by_key))
    t0 = time.time()
    vec_forecast = vectorized_final_forecast(modeling_by_key, horizon, fast_arima, n_jobs)
    log.info("Vectorized final forecast done in %.1fs.", time.time() - t0)

    log.info("Fitting HistGradientBoostingRegressor per segment and writing results...")
    n_ok = n_skipped = n_error = 0
    overall_forecast_df, overall_metrics = None, None
    for i, key in enumerate(series_by_key, start=1):
        seg = segment_by_key[key]
        try:
            metrics, forecast_df, hist_days, backlog_days = process_segment(
                seg, series_by_key[key], as_of, horizon,
                vec_metrics.get(key, {}), vec_forecast.get(key, {}),
            )
            if forecast_df is None:
                write_segment_result(conn, run_date, seg.customer, seg.material_group, 0, 0, [],
                                      None, status="skipped", error_message="No historical data.")
                n_skipped += 1
            else:
                write_segment_result(conn, run_date, seg.customer, seg.material_group,
                                      hist_days, backlog_days, metrics, forecast_df)
                n_ok += 1
                if seg.is_overall:
                    overall_forecast_df, overall_metrics = forecast_df, metrics
        except Exception as exc:
            log.exception("Segment %s / %s failed", seg.customer, seg.material_group)
            write_segment_result(conn, run_date, seg.customer, seg.material_group, 0, 0, [],
                                  None, status="error", error_message=str(exc))
            n_error += 1
        if i % 50 == 0 or i == len(series_by_key):
            log.info("  ...%d/%d segments written (ok=%d, skipped=%d, error=%d)", i, len(series_by_key),
                      n_ok, n_skipped, n_error)

    if overall_forecast_df is not None:
        write_overall_excel(overall_forecast_df, overall_metrics, excel_out_path)
        log.info("Wrote overall comparison workbook: %s", excel_out_path)
    else:
        log.warning("Could not compute the overall segment -- no Excel file written this run.")

    conn.close()
    log.info(
        "Done in %.1fs total. %d ok, %d skipped (insufficient history), %d errored. Results in %s.",
        time.time() - t_start, n_ok, n_skipped, n_error, db_path,
    )


