def write_overall_excel(forecast_df: pd.DataFrame, metrics: List[ModelMetrics], out_path: Union[str, Path]) -> None:
    from openpyxl.styles import Font

    display_cols = ["forecast_date", "Seasonal Naive", "AutoARIMA", "AutoETS",
                     "HistGradientBoostingRegressor", "Average", "known_backlog"]
    df = forecast_df[display_cols].rename(columns={"known_backlog": "Known Backlog"})
    metrics_df = pd.DataFrame([{
        "model": m.model_name, "wape": m.wape, "mae": m.mae, "accuracy_score": m.accuracy_score,
        "skipped": m.skipped, "skip_reason": m.skip_reason,
    } for m in metrics])

    with pd.ExcelWriter(out_path, engine="openpyxl") as writer:
        df.to_excel(writer, sheet_name="Overall Forecast", index=False)
        metrics_df.to_excel(writer, sheet_name="Backtest Accuracy", index=False)
        ws = writer.sheets["Overall Forecast"]
        for col_i in range(2, len(display_cols) + 1):
            for row_i in range(2, len(df) + 2):
                ws.cell(row=row_i, column=col_i).number_format = "#,##0"
        for cell in ws[1]:
            cell.font = Font(bold=True)


