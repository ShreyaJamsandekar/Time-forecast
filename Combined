def _build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--workbook", default="Sales Order 2024-26.xlsx", help="Path to the Sales Order workbook.")
    p.add_argument("--db", default="forecasts.sqlite", help="SQLite file to write/read results.")
    p.add_argument("--excel-out", default="overall_forecast.xlsx", help="Excel file for the overall segment.")
    p.add_argument("--horizon", type=int, default=DEFAULT_HORIZON_DAYS, help="Forecast horizon in days.")
    p.add_argument("--n-windows", type=int, default=N_BACKTEST_WINDOWS_PREFERRED, help="Preferred backtest windows.")
    p.add_argument("--thorough-arima", action="store_true",
                    help="Use AutoARIMA's full search instead of the faster reduced-search default.")
    p.add_argument("--n-jobs", type=int, default=-1, help="CPU cores to use (-1 = all available).")
    p.add_argument("--limit", type=int, default=None, help="Only process the first N customer/material segments "
                    "(plus the overall segment) -- useful for a quick timing test.")
    p.add_argument("--overwrite", action="store_true", help="Recompute segments even if already done for this run_date.")
    p.add_argument("--as-of", default=None, help="Historical cutoff date (YYYY-MM-DD). Defaults to today.")
    p.add_argument("--run-date", default=None, help="Label for this batch run (YYYY-MM-DD). Defaults to today.")
    return p


def main() -> None:
    args = _build_arg_parser().parse_args()
    as_of = pd.Timestamp(args.as_of) if args.as_of else None
    run_batch(
        workbook_path=args.workbook, db_path=args.db, excel_out_path=args.excel_out,
        horizon=args.horizon, preferred_windows=args.n_windows, fast_arima=not args.thorough_arima,
        n_jobs=args.n_jobs, limit=args.limit, overwrite=args.overwrite, as_of=as_of, run_date=args.run_date,
    )


if __name__ == "__main__":
    main()
